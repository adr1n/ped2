;portas:
CONSTANT swa, 01 
CONSTANT swb, 02
CONSTANT leds, 03
;
;nomeando registradores:
NAMEREG s1, x 
NAMEREG s2, y
NAMEREG s3, t3
NAMEREG s4, t4
NAMEREG s5, t5
NAMEREG s6, t6
NAMEREG s7, t7
NAMEREG sE, a
NAMEREG sF, b
ENABLE INTERRUPT

espera:
    JUMP espera

start:
    ENABLE INTERRUPT
    INPUT a, swa
    INPUT b, swb  

comparar_a_b:
    COMPARE a, b
    JUMP c, b_maior

    a_maior:
        LOAD x, a
        LOAD y, b
        JUMP operacoes
    
    b_maior:
        LOAD x, b
        LOAD y, a
        

operacoes:
    LOAD t3, x
    LOAD t5, x
    LOAD t4, y
    ;
    SR0 t3 
    SR0 t3
    SR0 t3
    ;
    SR0 t4
    ADD s8, 50 ;espera
    LOAD t6, t4
    ;
    SUB t5, t3
    ADD s8, F0 ;espera
    ;
    ADD t6, t5

comparar_t6_x:
    COMPARE t6, x
        JUMP c, x_maior
            LOAD t7, t6
        JUMP saida
        x_maior:
            LOAD t7, x

saida:
    OUTPUT leds, t7
    JUMP espera

ADRESS 3FF
    JUMP start